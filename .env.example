# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit real values.
# News Intelligence LLM extraction (optional; without a key only rule-based extraction runs).
# Provider is picked from NEWS_LLM_PROVIDER (gemini | deepseek | anthropic) or the first key found.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# NEWS_LLM_PROVIDER=gemini
# NEWS_LLM_MODEL=gemini-3.1-flash-lite
# Extra RSS feeds: JSON array of {id,name,url,reliability}
# NEWS_RSS_FEEDS=[{"id":"example","name":"Example FC","url":"https://example.com/rss.xml","reliability":0.6}]
# Set to 1 to switch News Intelligence off entirely.
# NEWS_DISABLED=1
